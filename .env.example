# Copy to .env (never commit .env). Load with: set -a; source .env; set +a

# τ²-bench (agent + simulated customer): set ONE of these. scripts/tau2_first_run.sh picks it up.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

HF_TOKEN=            # Hub token with write access to the team org (gated Cohere models need licence acceptance)
WANDB_API_KEY=       # optional; or set train.report_to=trackio / none
WANDB_PROJECT=lexsi-track3
HF_ORG=reagent-lexsi     # team org: https://huggingface.co/reagent-lexsi
