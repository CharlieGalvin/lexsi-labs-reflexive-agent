# Copy to .env (never commit .env). Load with: set -a; source .env; set +a

# τ²-bench. Agent + simulated customer: either key. Scoring retail/airline needs OPENAI_API_KEY
# (τ²-bench's LLM judges are pinned to OpenAI models). Telecom works with OpenRouter alone.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Teacher (Aya Expanse 32B) via the Cohere API. Trial keys: 20 requests/min, 1,000 calls/month.
# See docs/TEACHER_SETUP.md. Create one at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
TEACHER_RPM=20       # requests/min the teacher driver allows itself; raise for a production key

HF_TOKEN=            # Hub token with write access to the team org (gated Cohere models need licence acceptance)
WANDB_API_KEY=       # optional; or set train.report_to=trackio / none
WANDB_PROJECT=lexsi-track3
HF_ORG=reagent-lexsi     # team org: https://huggingface.co/reagent-lexsi
